	keywords = {prostate cancer, lineage plasticity, Animals, Humans, Mice, Signal Transduction, Cell Proliferation, Male, Prostatic Neoplasms, Receptors, Androgen, Gene Expression Regulation, Neoplastic, Carcinogenesis, FOXA1, Cell Lineage, Cell Line, Tumor, Hepatocyte Nuclear Factor 3-alpha, androgen receptor independence, androgen receptor signaling, CP: Cancer, FOXA2, Hepatocyte Nuclear Factor 3-beta, pioneer transcription factor, small molecule inhibitor},
