@incollection{denmeade_cellular_2003,
	title = {Cellular {Organization} of the {Normal} {Prostate}},
	url = {https://www.ncbi.nlm.nih.gov/books/NBK14022/},
	abstract = {To understand the normal response of prostate cells to androgen, an appreciation of the cellular organization of the gland is required.3 The prostate is a tubuloalveolar gland composed of multiple secretory acini, each consisting of epithelial cells lining a central lumen. The acinar lumen is filled with fluid produced by these epithelial cells. This fluid drains into a system of branching epithelial ducts and tubules that eventually end in the prostatic urethra. The epithelial compartment is composed of two types of cells, basal epithelial and glandular epithelial cells. The basal epithelial cells synthesize and secrete the components of the basement membrane of the acini on which they rest and are numerically less frequent and not as extensively developed morphologically for protein synthesis and bulk secretion as the glandular cells.3 The function of the basal epithelial cells is not fully understood, but a subset of basal cells are the stem cells for the glandular epithelial cells.4–8 The glandular epithelial cells that attach to the basal cells and extend to the acinar lumen are secretory active cells that form the prostate fluid. These cells express the androgen receptor and synthesize and secrete into the acinar lumen as series of distinct prostate differentiation markers (eg, prostate-specific antigen [PSA], prostate-specific acid phosphatase polyamines, and prostaglandins). A well-developed basement membrane separates the epithelial acini and ducts from the surrounding fibromuscular stromal tissue. The prostatic stromal tissue is composed of fibroblasts, smooth muscle cells, endothelial cells, nerves, and assorted infiltrating cells (eg, mast cells, lymphocytes). Thus, the prostatic basal and glandular cells receive nutrients and androgen that have traversed the endothelial cells, stromal cells, extracellular matrix, and acinar basement membrane. Consequently, the stromal compartment has ample opportunity to modify the epithelial cell microenvironment.},
	language = {en},
	urldate = {2026-08-11},
	booktitle = {Holland-{Frei} {Cancer} {Medicine}. 6th edition},
	publisher = {BC Decker},
	author = {Denmeade, Samuel R. and Isaacs, John T.},
	year = {2003},
	file = {Snapshot:/Users/cruoff/Zotero/storage/3ZXKXBTB/NBK14022.html:text/html},
}

@incollection{lamb_pre-malignant_2011,
	address = {New York, NY},
	title = {Pre-malignant {Disease} in the {Prostate}},
	isbn = {978-1-4419-6694-0},
	url = {https://doi.org/10.1007/978-1-4419-6694-0_22},
	doi = {10.1007/978-1-4419-6694-0_22},
	abstract = {Carcinoma of the prostate (CaP) is the most common non-cutaneous cancer in men and the second most common cause of cancer related death. Mortality remains high despite improvements in diagnosis in the developed world. A better understanding of the mechanisms involved in the development of prostate cancer should allow targeted diagnosis, prevention and treatment, and may improve mortality. In this chapter, we outline the two principal pre-malignant histological types, prostate intraepithelial neoplasia (PIN) and atypical small acinar proliferation (ASAP) and the likelihood of progression to CaP if these diagnoses are made. We then assess current understanding of factors contributing to the initiation of pre-malignant disease and progression to CaP as they relate to stem cells, inflammation, diet and specific genetic mutations or aberrant pathways. Finally, we discuss the translational potential of these factors in early detection and prevention of CaP.},
	language = {en},
	urldate = {2026-08-11},
	booktitle = {Pre-{Invasive} {Disease}: {Pathogenesis} and {Clinical} {Management}},
	publisher = {Springer},
	author = {Lamb, Alastair D. and Warren, Anne Y. and Neal, David E.},
	editor = {Fitzgerald, Rebecca C.},
	year = {2011},
	keywords = {Prostate Cancer, Androgen Receptor, Cancer Stem Cell, Prostate Cancer Mortality, Prostate Cancer Risk},
	pages = {467--491},
	file = {Full Text PDF:/Users/cruoff/Zotero/storage/EW42U4T5/Lamb et al. - 2011 - Pre-malignant Disease in the Prostate.pdf:application/pdf},
}

@article{pitzen_basal_nodate,
	title = {Basal epithelial cells in prostate development, tumorigenesis, and cancer progression},
	volume = {22},
	issn = {1538-4101},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC10228417/},
	doi = {10.1080/15384101.2023.2206502},
	abstract = {The prostate epithelium is composed of two predominant cell populations: luminal and basal epithelial cells. Luminal cells have a secretory function that supports male fertility while basal cells function in regeneration and maintenance of epithelial tissue. Recent studies in humans and mice have expanded our knowledge of the role and regulation of luminal and basal cells in prostate organogenesis, development, and homeostasis. The insights from healthy prostate biology can inform studies focused on the origins of prostate cancer, progression of the disease, and development of resistance to targeted hormonal therapies. In this review, we discuss a critical role for basal cells in the development and maintenance of healthy prostate tissue. Additionally, we provide evidence supporting a role for basal cells in oncogenesis and therapeutic resistance mechanisms of prostate cancer. Finally, we describe basal cell regulators that may promote lineage plasticity and basal cell identity in prostate cancers that have developed therapeutic resistance. These regulators could serve as therapeutic targets to inhibit or delay resistance and thereby improve outcomes for prostate cancer patients.},
	number = {11},
	urldate = {2026-08-11},
	journal = {Cell Cycle},
	author = {Pitzen, Samuel P. and Dehm, Scott M.},
	pages = {1303--1318},
	file = {Full Text PDF:/Users/cruoff/Zotero/storage/5HND4DR6/Pitzen and Dehm - Basal epithelial cells in prostate development, tumorigenesis, and cancer progression.pdf:application/pdf},
}

@article{butler_neuroendocrine_2021,
	title = {Neuroendocrine cells of the prostate: {Histology}, biological functions, and molecular mechanisms},
	volume = {4},
	issn = {2096-5303},
	shorttitle = {Neuroendocrine cells of the prostate},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC8023015/},
	doi = {10.1093/pcmedi/pbab003},
	abstract = {Prostate cancer (PCa) is a common cause of cancer-related mortality in men worldwide. Although most men are diagnosed with low grade, indolent tumors that are potentially curable, a significant subset develops advanced disease where hormone therapy is required to target the androgen receptor (AR). Despite its initial effect, hormone therapy eventually fails and the tumor progresses to lethal stages even through continued inhibition of AR. This review article focuses on the role of PCa cellular heterogeneity in therapy resistance and disease progression. Although AR-positive luminal-type cells represent the vast majority of PCa cells, there exists a minor component of AR-negative neuroendocrine (NE) cells that are resistant to hormonal therapy and are enriched by the treatment. In addition, it is now well accepted that a significant subset of hormonally treated tumors recur as small cell neuroendocrine carcinoma (SCNC), further highlighting the importance of targeting NE cells in addition to the more abundant luminal-type cancer cells. Although it has been long recognized that NE cells are present in PCa, their underlying function in benign prostate and molecular mechanisms contributing to PCa progression remains poorly understood. In this article, we review the morphology and function of NE cells in benign prostate and PCa as well as underlying molecular mechanisms. In addition, we review the major reported mechanisms for transformation from common adenocarcinoma histology to the highly lethal SCNC, a significant clinical challenge in the management of advanced PCa.},
	number = {1},
	urldate = {2026-08-11},
	journal = {Precis Clin Med},
	author = {Butler, William and Huang, Jiaoti},
	month = jan,
	year = {2021},
	pages = {25--34},
	file = {Full Text PDF:/Users/cruoff/Zotero/storage/8T7BSPRD/Butler and Huang - 2021 - Neuroendocrine cells of the prostate Histology, biological functions, and molecular mechanisms.pdf:application/pdf},
}

