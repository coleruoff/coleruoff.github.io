	keywords = {Genomics, Epigenomics, Humans, Epigenesis, Genetic, Male, Prostatic Neoplasms, Genome, Human, Gene Expression Regulation, Neoplastic, Mutation, Transcriptome, RNA-Seq, Cell Transformation, Neoplastic, DNA Methylation, DNA-Binding Proteins, Nerve Tissue Proteins, Hepatocyte Nuclear Factor 3-alpha, Asian People, Carrier Proteins, China, Cohort Studies, DNA Helicases},
	pages = {93--99},
