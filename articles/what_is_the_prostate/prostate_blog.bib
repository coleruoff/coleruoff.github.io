@article{aaron_review_2016,
	title = {Review of {Prostate} {Anatomy} and {Embryology} and the {Etiology} of {Benign} {Prostatic} {Hyperplasia}},
	volume = {43},
	issn = {1558-318X},
	doi = {10.1016/j.ucl.2016.04.012},
	abstract = {Prostate development follows a common pattern between species and depends on the actions of androgens to induce and support ductal branching morphogenesis of buds emerging from the urogenital sinus. The human prostate has a compact zonal anatomy immediately surrounding the urethra and below the urinary bladder. Rodents have a lobular prostate with lobes radiating away from the urethra. The human prostate is the site of benign hyperplasia, prostate cancer, and prostatitis. The rodent prostate has little naturally occurring disease. Rodents can be used to model aspects of human benign hyperplasia, but care should be taken in data interpretation and extrapolation to the human condition.},
	language = {eng},
	number = {3},
	journal = {Urol Clin North Am},
	author = {Aaron, LaTayia and Franco, Omar E. and Hayward, Simon W.},
